[Unit]
Description=Wormhole tunnel
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wormhole run -c /etc/wormhole/config.toml
Restart=always
RestartSec=2
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
